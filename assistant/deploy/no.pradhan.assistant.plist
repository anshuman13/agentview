<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>no.pradhan.assistant</string>
  <key>Program</key><string>/bin/zsh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/oda/workspace_personal/agentview &amp;&amp; exec npm run start -w assistant</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>/Users/oda/workspace_personal/agentview</string>
  <key>StandardOutPath</key><string>/Users/oda/.agentview/assistant/api.log</string>
  <key>StandardErrorPath</key><string>/Users/oda/.agentview/assistant/api.log</string>
</dict>
</plist>
