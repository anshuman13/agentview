{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentView",
  "version": "0.1.0",
  "identifier": "no.pradhan.agentview",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgentView",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
