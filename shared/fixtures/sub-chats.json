        { "sessionId": "a", "cwd": "/r", "branch": "main", "account": "p", "lastAt": 1000 },
        { "sessionId": "b", "cwd": "/r", "branch": "main", "account": "p", "lastAt": 1010 },
        { "sessionId": "c1", "cwd": "/r", "branch": "main", "account": "p", "lastAt": 5000, "clearAt": 1060 }
