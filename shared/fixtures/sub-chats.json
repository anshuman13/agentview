        { "sessionId": "t2", "parentId": "a", "text": "best" },
        { "sessionId": "a", "text": "second" },
        { "sessionId": "b", "text": "other chat" }
      ],
      "expected": [
        { "sessionId": "t2", "parentId": "a", "text": "best", "session": "a", "sub": "t2" },
        { "sessionId": "b", "text": "other chat", "session": "b" }
      ]
    }
  ],
