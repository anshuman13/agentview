    { "name": "an older link to another sub-chat", "links": { "b": { "parent": "a", "via": "clear", "at": 2 }, "c": { "parent": "b", "via": "clear", "at": 3 } }, "id": "c", "expected": "a" },
    { "name": "a loop stops", "links": { "a": { "parent": "b", "via": "clear", "at": 1 }, "b": { "parent": "a", "via": "clear", "at": 2 } }, "id": "a", "expected": "a" }
  ],
  "subChatLabel": [
    { "count": 0, "allBuild": false, "expected": "" },
    { "count": 1, "allBuild": false, "expected": "1 sub-chat" },
    { "count": 12, "allBuild": false, "expected": "12 sub-chats" },
    { "count": 1, "allBuild": true, "expected": "1 task" },
    { "count": 62, "allBuild": true, "expected": "62 tasks" }
  ],
  "groupSessions": [
    {
      "name": "no links",
      "saved": [{ "sessionId": "a", "lastModified": 30 }, { "sessionId": "b", "lastModified": 20 }],
      "open": [],
      "expected": [
        { "root": "a", "latest": "a", "count": 0, "label": "", "lastModified": 30, "members": ["a"] },
        { "root": "b", "latest": "b", "count": 0, "label": "", "lastModified": 20, "members": ["b"] }
      ]
    },
    {
      "name": "one chain",
      "saved": [
        { "sessionId": "c2", "lastModified": 50, "parentId": "a", "via": "clear", "startedAt": 40 },
        { "sessionId": "x", "lastModified": 35 },
        { "sessionId": "c1", "lastModified": 30, "parentId": "a", "via": "clear", "startedAt": 20 },
        { "sessionId": "a", "lastModified": 10 }
      ],
      "open": [],
      "expected": [
        { "root": "a", "latest": "c2", "count": 2, "label": "2 sub-chats", "lastModified": 50, "members": ["a", "c1", "c2"] },
        { "root": "x", "latest": "x", "count": 0, "label": "", "lastModified": 35, "members": ["x"] }
      ]
    },
    {
      "name": "a build chain",
      "saved": [
        { "sessionId": "t2", "lastModified": 50, "parentId": "a", "via": "build", "startedAt": 40 },
        { "sessionId": "t1", "lastModified": 30, "parentId": "a", "via": "build", "startedAt": 20 },
        { "sessionId": "a", "lastModified": 10 }
      ],
      "open": [],
      "expected": [{ "root": "a", "latest": "t2", "count": 2, "label": "2 tasks", "lastModified": 50, "members": ["a", "t1", "t2"] }]
    },
    {
      "name": "a mixed chain",
      "saved": [
        { "sessionId": "a", "lastModified": 10 },
        { "sessionId": "t1", "lastModified": 30, "parentId": "a", "via": "build", "startedAt": 20 },
        { "sessionId": "c1", "lastModified": 50, "parentId": "a", "via": "clear", "startedAt": 40 }
      ],
      "open": [],
      "expected": [{ "root": "a", "latest": "c1", "count": 2, "label": "2 sub-chats", "lastModified": 50, "members": ["a", "t1", "c1"] }]
    },
    {
      "name": "a sub-chat whose parent is in the bin or missing stands on its own",
      "saved": [
        { "sessionId": "c1", "lastModified": 30, "parentId": "gone", "via": "clear", "startedAt": 20 },
        { "sessionId": "b", "lastModified": 20 }
      ],
      "open": [],
      "expected": [
        { "root": "c1", "latest": "c1", "count": 0, "label": "", "lastModified": 30, "members": ["c1"] },
        { "root": "b", "latest": "b", "count": 0, "label": "", "lastModified": 20, "members": ["b"] }
      ]
    },
    {
      "name": "a parent with a live open chat in a new sub-chat",
      "saved": [
        { "sessionId": "t1", "lastModified": 30, "parentId": "a", "via": "build", "startedAt": 20 },
        { "sessionId": "a", "lastModified": 10 },
        { "sessionId": "b", "lastModified": 40 }
      ],
      "open": [{ "sessionId": "live", "parentId": "a", "lastActive": 60 }, { "sessionId": "t1", "parentId": "a", "lastActive": 30 }, { "sessionId": null }],
      "expected": [
        { "root": "a", "latest": "live", "count": 2, "label": "2 sub-chats", "lastModified": 60, "members": ["a", "t1", "live"] },
        { "root": "b", "latest": "b", "count": 0, "label": "", "lastModified": 40, "members": ["b"] }
      ]
    }
  ],
  "searchHitRows": [
    {
      "name": "a hit in a sub-chat opens the parent at the sub-chat",
      "hits": [{ "sessionId": "t2", "parentId": "a", "text": "found in task 2" }],
